#!/usr/bin/env bash
echo "$@" >> "$RUNNER_TEMP/atoma-argv.txt"
prev=""
for a in "$@"; do
  if [ "$prev" = "--credentials-file" ]; then
    if [ ! -f "$a" ]; then
      echo "Error: Failed to read credentials file: \"$a\"" >&2
      exit 1
    fi
    cp "$a" "$RUNNER_TEMP/credentials-seen-by-atoma.json"
    rm -f "$a"
  fi
  prev="$a"
done
echo "Done; the second turn's report."
exit 0
