     name: Merge the release pull request, and wait for the release
@@ -483,13 +498,13 @@ jobs:
           fi
 
           # Wait for the REQUIRED check to EXIST, not for the visible checks to
-          # finish. The check workflow runs in two phases -- plan jobs first, and
-          # they dispatch the real check -- so on a pull request opened moments
-          # ago, `atomaton-check` is not in the rollup yet, and every check that
-          # IS visible can be green while the deciding one does not exist. The
-          # measured failure was a merge the base branch policy refused in
-          # exactly that state. The check was dispatched by the previous job, so
-          # its arrival is a matter of minutes, not a maybe.
+          # finish. It is written by the validator once CI has concluded, so on a
+          # pull request opened moments ago `atomaton-check` is not in the rollup
+          # yet, and every check that IS visible can be green while the deciding
+          # one does not exist. The measured failure was a merge the base branch
+          # policy refused in exactly that state. The previous job hands the pull
+          # request to the validator, so the check's arrival is minutes, not a
+          # maybe.
           SEEN=""
           for _ in $(seq 1 90); do
             SEEN=$(gh pr view "$PR" --repo "$REPO" --json statusCheckRollup --jq '[.statusCheckRollup[] | select(.name == "atomaton-check")] | length')
