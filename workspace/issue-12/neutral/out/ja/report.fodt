<?xml version="1.0" encoding="UTF-8"?>
<!--
  report.fodt — the default Word template: a customer-facing design document.

  Flat ODF rather than a .docx, because this file is the thing a person edits: a
  heading's size, a table's column widths and the words between them are all one
  XML text, readable in a diff. A name in double braces is a placeholder and
  `customer-doc.mjs fill` substitutes it, converting this file to docx; a fix is
  an edit here followed by the same command.

  Sections are part of the template — edit them here. The content of each is a
  placeholder, so nothing in the output is a paragraph this file did not ask for.

  The template holds structure and formatting only: every word a reader sees is a
  placeholder, so the language of the document is the data's choice, not this
  file's. The ordinal in a heading ("1.") and an ASCII separator between two
  values are structure and stay here; a label placeholder carries its own
  punctuation, so a locale supplies "Client:" or its own word and colon together.
-->
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  office:version="1.3"
  office:mimetype="application/vnd.oasis.opendocument.text">

  <office:font-face-decls>
    <style:font-face style:name="Noto Sans CJK JP" svg:font-family="'Noto Sans CJK JP'" style:font-family-generic="swiss" style:font-pitch="variable"/>
  </office:font-face-decls>

  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="155%" fo:margin-bottom="0.25cm"/>
      <style:text-properties
        style:font-name="Noto Sans CJK JP" style:font-name-asian="Noto Sans CJK JP" style:font-name-complex="Noto Sans CJK JP"
        fo:font-size="10.5pt" style:font-size-asian="10.5pt" style:font-size-complex="10.5pt"
        fo:language="en" fo:country="US" style:language-asian="ja" style:country-asian="JP"
        fo:color="#1c1c1c"/>
    </style:default-style>

    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties style:font-name="Noto Sans CJK JP" fo:font-size="8pt" style:font-size-asian="8pt" style:font-name-asian="Noto Sans CJK JP" fo:color="#8a8a8a" fo:language="en" fo:country="US" style:language-asian="ja" style:country-asian="JP"/>
    </style:style>
  </office:styles>

  <office:automatic-styles>
    <!-- This must live in office:automatic-styles, not in office:styles above: a
         layout outside it is not bound to the master page, and the docx export then
         writes LibreOffice's own margins — 1134 twips left/right/top and 1417 bottom,
         measured — instead of the ones below (1361/1247/1530). -->
    <style:page-layout style:name="pm1">
      <style:page-layout-properties
        fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait"
        fo:margin-top="2.2cm" fo:margin-bottom="2.2cm" fo:margin-left="2.4cm" fo:margin-right="2.4cm"/>
    </style:page-layout>

    <style:style style:name="P_Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="4cm" fo:margin-bottom="0.3cm"/>
      <style:text-properties style:font-name="Noto Sans CJK JP" fo:font-size="26pt" style:font-size-asian="26pt" style:font-name-asian="Noto Sans CJK JP" fo:font-weight="bold" fo:color="#12324f" fo:language="en" fo:country="US" style:language-asian="ja" style:country-asian="JP"/>
    </style:style>
    <style:style style:name="P_Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.9cm" fo:padding-bottom="0.3cm" fo:border-bottom="1pt solid #1f6feb"/>
      <style:text-properties style:font-name="Noto Sans CJK JP" fo:font-size="13pt" style:font-size-asian="13pt" style:font-name-asian="Noto Sans CJK JP" fo:color="#4a5568" fo:language="en" fo:country="US" style:language-asian="ja" style:country-asian="JP"/>
    </style:style>
    <style:style style:name="P_H1" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.9cm" fo:margin-bottom="0.35cm" fo:border-left="3pt solid #1f6feb" fo:padding-left="0.25cm" fo:keep-with-next="always"/>
      <style:text-properties style:font-name="Noto Sans CJK JP" fo:font-size="15pt" style:font-size-asian="15pt" style:font-name-asian="Noto Sans CJK JP" fo:font-weight="bold" fo:color="#12324f" fo:language="en" fo:country="US" style:language-asian="ja" style:country-asian="JP"/>
    </style:style>
    <style:style style:name="P_Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.35cm"/>
      <style:text-properties style:font-name="Noto Sans CJK JP" fo:font-size="10.5pt" style:font-size-asian="10.5pt" style:font-name-asian="Noto Sans CJK JP" fo:language="en" fo:country="US" style:language-asian="ja" style:country-asian="JP"/>
    </style:style>
    <style:style style:name="P_SectionStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.35cm" fo:border-left="3pt solid #1f6feb" fo:padding-left="0.25cm" fo:keep-with-next="always"/>
      <style:text-properties style:font-name="Noto Sans CJK JP" fo:font-size="15pt" style:font-size-asian="15pt" style:font-name-asian="Noto Sans CJK JP" fo:font-weight="bold" fo:color="#12324f" fo:language="en" fo:country="US" style:language-asian="ja" style:country-asian="JP"/>
    </style:style>
    <style:style style:name="P_CellHead" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="Noto Sans CJK JP" fo:font-size="9.5pt" style:font-size-asian="9.5pt" style:font-name-asian="Noto Sans CJK JP" fo:font-weight="bold" fo:color="#ffffff" fo:language="en" fo:country="US" style:language-asian="ja" style:country-asian="JP"/>
    </style:style>
    <style:style style:name="P_Cell" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="Noto Sans CJK JP" fo:font-size="9.5pt" style:font-size-asian="9.5pt" style:font-name-asian="Noto Sans CJK JP" fo:language="en" fo:country="US" style:language-asian="ja" style:country-asian="JP"/>
    </style:style>
    <style:style style:name="P_CellLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-bottom="0cm" fo:padding-right="0.3cm"/>
      <style:text-properties style:font-name="Noto Sans CJK JP" fo:font-size="10pt" style:font-size-asian="10pt" style:font-name-asian="Noto Sans CJK JP" fo:color="#6b7280" fo:language="en" fo:country="US" style:language-asian="ja" style:country-asian="JP"/>
    </style:style>
    <style:style style:name="P_CellValue" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="Noto Sans CJK JP" fo:font-size="10pt" style:font-size-asian="10pt" style:font-name-asian="Noto Sans CJK JP" fo:font-weight="bold" fo:language="en" fo:country="US" style:language-asian="ja" style:country-asian="JP"/>
    </style:style>

    <style:style style:name="T_Grid" style:family="table">
      <style:table-properties style:width="16.2cm" table:align="margins" table:border-model="collapsing" style:may-break-between-rows="false"/>
    </style:style>
    <style:style style:name="T_Meta" style:family="table">
      <style:table-properties style:width="16.2cm" table:align="margins" table:border-model="collapsing" style:may-break-between-rows="false"/>
    </style:style>
    <style:style style:name="C_Grid1" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="C_Grid2" style:family="table-column">
      <style:table-column-properties style:column-width="12cm"/>
    </style:style>
    <style:style style:name="C_Meta1" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="C_Meta2" style:family="table-column">
      <style:table-column-properties style:column-width="13cm"/>
    </style:style>

    <!-- This is what makes the docx carry w:cantSplit; style:may-break-between-rows
         on the table does not (it exports as w:keepNext). -->
    <style:style style:name="R_Keep" style:family="table-row">
      <style:table-row-properties fo:keep-together="always"/>
    </style:style>

    <style:style style:name="CellHead" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#12324f" fo:border="0.5pt solid #12324f" fo:padding="0.16cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #c9d2dc" fo:padding="0.16cm"/>
    </style:style>
    <style:style style:name="CellAlt" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#f3f6fa" fo:border="0.5pt solid #c9d2dc" fo:padding="0.16cm"/>
    </style:style>
    <style:style style:name="CellMetaLabel" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.12cm"/>
    </style:style>
    <style:style style:name="CellMetaValue" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.12cm"/>
    </style:style>
  </office:automatic-styles>

  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="pm1">
      <style:footer>
        <text:p text:style-name="Footer">株式会社サンプル | 在庫管理システム刷新 設計書 | <text:page-number text:select-page="current">1</text:page-number> / <text:page-count>1</text:page-count></text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>

  <office:body>
    <office:text>
      <text:p text:style-name="P_Title">在庫管理システム刷新 設計書</text:p>
      <text:p text:style-name="P_Subtitle">株式会社サンプル 御中</text:p>

      <table:table table:name="Meta" table:style-name="T_Meta">
        <table:table-column table:style-name="C_Meta1"/>
        <table:table-column table:style-name="C_Meta2"/>
        <table:table-row table:style-name="R_Keep">
          <table:table-cell table:style-name="CellMetaLabel" office:value-type="string"><text:p text:style-name="P_CellLabel">顧客</text:p></table:table-cell>
          <table:table-cell table:style-name="CellMetaValue" office:value-type="string"><text:p text:style-name="P_CellValue">株式会社サンプル</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="R_Keep">
          <table:table-cell table:style-name="CellMetaLabel" office:value-type="string"><text:p text:style-name="P_CellLabel">作成</text:p></table:table-cell>
          <table:table-cell table:style-name="CellMetaValue" office:value-type="string"><text:p text:style-name="P_CellValue">山田 太郎</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="R_Keep">
          <table:table-cell table:style-name="CellMetaLabel" office:value-type="string"><text:p text:style-name="P_CellLabel">版 / 日付</text:p></table:table-cell>
          <table:table-cell table:style-name="CellMetaValue" office:value-type="string"><text:p text:style-name="P_CellValue">1.0 / 2026年11月4日</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="P_SectionStart">1. 概要</text:p>
      <text:p text:style-name="P_Body">既存の在庫管理をクラウドへ移行し、棚卸の差異を当日中に可視化する。対象は 3 拠点・120 名。</text:p>

      <text:p text:style-name="P_H1">2. システム構成</text:p>
      <text:p text:style-name="P_Body">フロントは Web、業務ロジックは API 層に集約し、在庫の更新はイベント経由で非同期に反映する。</text:p>
      <table:table table:name="Components" table:style-name="T_Grid">
        <table:table-column table:style-name="C_Grid1"/>
        <table:table-column table:style-name="C_Grid2"/>
        <table:table-header-rows>
          <table:table-row table:style-name="R_Keep">
            <table:table-cell table:style-name="CellHead" office:value-type="string"><text:p text:style-name="P_CellHead">構成要素</text:p></table:table-cell>
            <table:table-cell table:style-name="CellHead" office:value-type="string"><text:p text:style-name="P_CellHead">役割</text:p></table:table-cell>
          </table:table-row>
        </table:table-header-rows>
        <table:table-row table:style-name="R_Keep">
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">Web フロント</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">入力・照会画面</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="R_Keep">
          <table:table-cell table:style-name="CellAlt" office:value-type="string"><text:p text:style-name="P_Cell">業務 API</text:p></table:table-cell>
          <table:table-cell table:style-name="CellAlt" office:value-type="string"><text:p text:style-name="P_Cell">在庫引当・差異計算</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="R_Keep">
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">バッチ基盤</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">日次棚卸の突合</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="P_H1">3. スケジュール</text:p>
      <table:table table:name="Schedule" table:style-name="T_Grid">
        <table:table-column table:style-name="C_Grid1"/>
        <table:table-column table:style-name="C_Grid2"/>
        <table:table-header-rows>
          <table:table-row table:style-name="R_Keep">
            <table:table-cell table:style-name="CellHead" office:value-type="string"><text:p text:style-name="P_CellHead">工程</text:p></table:table-cell>
            <table:table-cell table:style-name="CellHead" office:value-type="string"><text:p text:style-name="P_CellHead">期間 / 成果物</text:p></table:table-cell>
          </table:table-row>
        </table:table-header-rows>
        <table:table-row table:style-name="R_Keep">
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">要件定義</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">2 週間 / 要件定義書</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="R_Keep">
          <table:table-cell table:style-name="CellAlt" office:value-type="string"><text:p text:style-name="P_Cell">実装</text:p></table:table-cell>
          <table:table-cell table:style-name="CellAlt" office:value-type="string"><text:p text:style-name="P_Cell">6 週間 / 稼働版一式</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="R_Keep">
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">受入試験</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">2 週間 / 試験結果報告書</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="P_H1">4. 費用</text:p>
      <text:p text:style-name="P_Body">金額は税抜きの概算である。</text:p>
      <table:table table:name="Cost" table:style-name="T_Grid">
        <table:table-column table:style-name="C_Grid1"/>
        <table:table-column table:style-name="C_Grid2"/>
        <table:table-header-rows>
          <table:table-row table:style-name="R_Keep">
            <table:table-cell table:style-name="CellHead" office:value-type="string"><text:p text:style-name="P_CellHead">項目</text:p></table:table-cell>
            <table:table-cell table:style-name="CellHead" office:value-type="string"><text:p text:style-name="P_CellHead">金額</text:p></table:table-cell>
          </table:table-row>
        </table:table-header-rows>
        <table:table-row table:style-name="R_Keep">
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">要件定義</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">1,200,000 円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="R_Keep">
          <table:table-cell table:style-name="CellAlt" office:value-type="string"><text:p text:style-name="P_Cell">設計・実装</text:p></table:table-cell>
          <table:table-cell table:style-name="CellAlt" office:value-type="string"><text:p text:style-name="P_Cell">4,800,000 円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="R_Keep">
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">試験・導入支援</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">1,500,000 円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="R_Keep">
          <table:table-cell table:style-name="CellHead" office:value-type="string"><text:p text:style-name="P_CellHead">合計</text:p></table:table-cell>
          <table:table-cell table:style-name="CellHead" office:value-type="string"><text:p text:style-name="P_CellHead">7,500,000 円</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="P_H1">5. 体制・連絡先</text:p>
      <text:p text:style-name="P_Body">プロジェクト責任者: 山田 太郎 / 連絡先: taro@example.co.jp</text:p>
    </office:text>
  </office:body>
</office:document>
