        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">要件定義</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">2025年11月〜2025年12月 ／ 要件定義書・画面一覧</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellAlt" office:value-type="string"><text:p text:style-name="P_Cell">設計・開発</text:p></table:table-cell>
          <table:table-cell table:style-name="CellAlt" office:value-type="string"><text:p text:style-name="P_Cell">2026年1月〜2026年4月 ／ 設計書・動作するプロトタイプ</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">受入テスト・移行</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">2026年5月〜2026年6月 ／ 受入テスト報告書・移行手順書</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="P_H1">4. 費用</text:p>
      <text:p text:style-name="P_Body">以下は税別の概算である。クラウド利用料（月額 12 万円程度／仮）と、基幹システム側の改修費用は本見積に含まない。</text:p>
      <table:table table:name="Cost" table:style-name="T_Grid">
        <table:table-column table:style-name="C_Grid1"/>
        <table:table-column table:style-name="C_Grid2"/>
        <table:table-row>
          <table:table-cell table:style-name="CellHead" office:value-type="string"><text:p text:style-name="P_CellHead">項目</text:p></table:table-cell>
          <table:table-cell table:style-name="CellHead" office:value-type="string"><text:p text:style-name="P_CellHead">金額</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
