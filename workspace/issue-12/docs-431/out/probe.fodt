          <table:table-cell table:style-name="CellAlt" office:value-type="string"><text:p text:style-name="P_Cell">7,800,000 円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">受入支援・移行作業</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P_Cell">2,400,000 円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellHead" office:value-type="string"><text:p text:style-name="P_CellHead">合計</text:p></table:table-cell>
          <table:table-cell table:style-name="CellHead" office:value-type="string"><text:p text:style-name="P_CellHead">13,400,000 円</text:p></table:table-cell>
